{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "customer",
    "status",
    "provenance",
    "confidence",
    "explicitPreferences",
    "referenceApproval",
    "effectIntensity",
    "safeMarginX",
    "sourceTransformOrigin",
    "readabilityGradient",
    "colors"
  ],
  "properties": {
    "safeMarginX": {
      "type": "number",
      "minimum": 60,
      "maximum": 180
    },
    "colors": {
      "type": "object",
      "required": [
        "background",
        "surface",
        "line",
        "sceneText",
        "text",
        "key",
        "soft",
        "glow",
        "shadow",
        "depthLight",
        "depthMid",
        "depthDark",
        "materialHighlight",
        "materialMid",
        "materialShade"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PROPOSED_NOT_APPROVED",
        "CUSTOMER_APPROVED"
      ]
    },
    "effectIntensity": {
      "type": "string",
      "description": "Customer-specific choice, no global owner DNA"
    }
  }
}
